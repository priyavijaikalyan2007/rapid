/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; connect-src 'none'; font-src 'self' {{themeBaseUrl}}; form-action 'none'; frame-ancestors 'none'; img-src 'self' data:; object-src 'none'; script-src 'self' {{themeBaseUrl}}; style-src 'self' {{themeBaseUrl}}
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

/assets/*
  Cache-Control: public, max-age=86400
