/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; connect-src https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; font-src 'self' {{themeBaseUrl}}; form-action 'none'; frame-ancestors 'none'; img-src 'self' data: https://*.google-analytics.com https://www.googletagmanager.com; object-src 'none'; script-src 'self' {{themeBaseUrl}} https://www.googletagmanager.com; style-src 'self' {{themeBaseUrl}}
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

/assets/*
  Cache-Control: public, max-age=86400

/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8

/security.txt
  Content-Type: text/plain; charset=utf-8
